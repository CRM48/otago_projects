<form method="GET" action="/filter" id="filter-container">
    <button type="button" id="close-window">&times;</button>
    <h2>Filter & Sort</h2>
    <button type="button" id="status-button">Conservation Status</button>
    <div id="status-outer">
        <div id="status-container"></div>
    </div>
    <button type="button" id="size-button">Size</button>
    <div id="size-outer">
        <div id="size-container"></div>
    </div>
    <select id="sort" name="sort"></select>
    <button id="filter-confirm">Filter Selections</button>
</form>
<div id="background-overlay"></div>