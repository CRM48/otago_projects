<!DOCTYPE html>
<html lang = "en">
    <head>
        <meta charset="UTF-8">
        <title id="title"><%=bird.primary_name%></title>
        <link href="/css/information.css" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300&display=swap" rel="stylesheet">
    </head>
    <body id="body">
        <a href="/">
            <div id="back">
                <img src="/icons/back-icon-white.png" alt="">
                <h2>Back</h2>
            </div>
        </a>
        <div id="background-img" style="background-image: url(/images/<%=bird.filename%>);">
            <div id="black-overlay"></div>
        </div>
        <div id="names">
            <h1><%=bird.primary_name%></h1>
            <h2><%=bird.english_name%></h2>
        </div>
        <div id="bird-info">
            <div class="child_div">
                <div class="attributes">
                    <p>Scientific name</p>
                    <p>Family</p>
                    <p>Order</p>
                    <p>Status</p>
                    <p>Length</p>
                    <p>Weight</p>
                </div>
                <div class="details">
                    <p><%=bird.scientific_name%></p>
                    <p><%=bird.family%></p>
                    <p><%=bird.order_name%></p>
                    <p><%=bird.status_name%></p>
                    <p><%=bird.length%>cm</p>
                    <p><%=bird.weight%>g</p>
                </div>
            </div>
        </div>
        <img src="/images/<%=bird.filename%>" id="bird-img">
        <a href="/birds/<%= bird.bird_id %>/update">
            <button id="edit-button">Edit</button>
        </a>
        <form method="POST"
            action="/birds/<%= bird.bird_id %>/delete"
            onsubmit="return confirm('Are you sure you want to delete this bird?');">
            <button type="submit" id="delete-button">Delete</button>
        </form>
        
    </body>
</html>
